manifest {
    name            = 'MarkerMAG-nf'
    author          = 'Weizhi Song et al.'
    homePage        = 'https://github.com/xvazquezc/MarkerMAG-nf'
    description     = 'Link MAGs to 16S rRNA marker genes using paired-end short reads'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '1.0.0'
}

params {
    help         = false           // print this help message and exit

    // ── Input / output ──────────────────────────────────────────────────────────
    input        = null            // CSV samplesheet path (required)
    outdir       = 'results'       // output directory
    reconstruct_only = false       // stop after producing polished 16S sequences
    conda_cache_dir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.conda"

    // ── MATAM 16S assembly  (matam_16s.py / matam_assembly.py) ─────────────────
    // matam_db: directory containing one *.clustered.fasta MATAM index, or
    //           the full database prefix when the directory has multiple indexes.
    //           Build with: index_default_ssu_rrna_db.py -d $DBDIR
    matam_db      = null
    // Updated MATAM fork. An absolute path is recommended until the fork is
    // released as a Conda package.
    matam_executable = 'matam_assembly.py'

    // Subsample percentages passed to -pct in matam_16s.py.
    // Each value becomes one independent HPC job via MATAM_ASSEMBLE.
    // tool default: '1,5,10,25,50,75,100'
    matam_pcts    = '1,5,10,25,50,75,100'

    // CPUs allocated to each individual MATAM assembly job (process_matam label).
    // MATAM scales well up to ~8–16 threads; beyond that many stages are
    // single-threaded and additional CPUs go unused.
    // tool default (matam_assembly.py --cpu): 1
    matam_threads = 8

    // Maximum memory per MATAM assembly job (MB).
    // tool default (matam_assembly.py --max_memory): 10000
    matam_mem_mb  = 30000
    skip_matam    = false

    // ── 16S QC  (uclust_16s.py  ·  polish_16s.py / barrnap) ───────────────────
    // Identity threshold for UCLUST clustering of 16S sequences (0–1 scale).
    // Applied by UCLUST_16S before LINK_16S in both the MATAM and
    // user-provided-16S paths.
    // uclust_16s.py -i default: 1.0 (exact dereplication)
    // matam_16s.py  -i default: 0.999
    cluster_iden  = 0.99

    // Minimum 16S length (bp) accepted for linking.
    // Sequences shorter than this are filtered out inside link_16s.py.
    // tool default (link -min_16s_len): 1200
    min_16s_len   = 1200

    // ── Linking parameters  (link_16s.py / MarkerMAG link) ─────────────────────
    // Minimum number of paired-end read linkages required to report a MAG–16S
    // association.
    // tool default (link -min_link): 9
    min_link      = 9

    // Maximum genetic divergence (%) between 16S rRNA genes that can be linked
    // to the same MAG.
    // tool default (link -max_16s_div): 1
    max_16s_div   = 1

    // Maximum mismatch percentage allowed in read-to-16S alignments.
    // tool default (link -mismatch): 2
    mismatch      = 2

    // Minimum read alignment length (bp) against 16S or MAG contigs.
    // tool default (link -aln_len): 45
    aln_len       = 45

    // Minimum read alignment percentage (%) of read length.
    // tool default (link -aln_pct): 35
    aln_pct       = 35

    // ── Copy number estimation  (link_16s.py / get_cp_num.py) ──────────────────
    // Set true to skip copy number estimation inside LINK_16S (-skip_cn flag).
    // GET_CP_NUM can then be run as a separate step with different parameters.
    // tool default: false (copy number is estimated by default)
    skip_cp_num   = false

    // Fraction of reads (%) used for MAG coverage estimation in copy number step.
    // Using a subset speeds up the calculation; 25 % is a good trade-off.
    // tool default (link -subsample_pct / get_cp_num -subsample_pct): 25
    subsample_pct = 25

    // ── Preprocessing  (rename_reads.py) ───────────────────────────────────────
    // Set true to rename reads to MarkerMAG format ({prefix}_N.1 / _N.2)
    // before running the analysis. Required if read IDs are not already unique
    // and consistently paired.
    // tool default: not run (optional pre-processing step)
    rename_reads  = false

    // ── Resource ceilings  (applied in conf/base.config via check_max) ─────────
    max_cpus      = 48
    max_memory    = '256.GB'
    max_time      = '240.h'
}

includeConfig 'conf/base.config'

profiles {
    standard    { process.executor = 'local' }
    test        { process.executor = 'local'; includeConfig 'conf/test.config' }
    hpc         { includeConfig 'conf/hpc.config' }

    docker {
        docker.enabled       = true
        docker.userEmulation = true
        singularity.enabled  = false
        conda.enabled        = false
        process.container    = 'markermag:latest'
    }
    singularity {
        singularity.enabled  = true
        singularity.autoMounts = true
        docker.enabled       = false
        conda.enabled        = false
        process.container    = 'docker://markermag:latest'
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        // Build one pinned environment from the workflow YAML and reuse it
        // from a shared cache. Override the default with --conda_cache_dir or
        // NXF_CONDA_CACHEDIR on HPC systems.
        conda.cacheDir       = params.conda_cache_dir
        process.conda        = "${projectDir}/environment.yml"
    }
}
