// HPC profile — switch executor and queue to match your scheduler.
// Change 'pbspro' to 'slurm' for SLURM-based clusters.

process {
    executor       = 'pbspro'   // or 'slurm'
    clusterOptions = ''
    queue          = 'normal'
}

executor {
    queueSize       = 100
    submitRateLimit = '10 sec'
}
