// ── Test profile resource limits and parameters ────────────────────────────────
// Used with: nextflow run main.nf -profile test
// Runs the "provided 16S" path (no MATAM) on synthetic data.

params {
    // Tiny resource ceilings for a local test run
    max_cpus    = 2
    max_memory  = '4.GB'
    max_time    = '1.h'

    // Skip MATAM — use the pre-built 16S FASTA in the samplesheet
    skip_matam  = true

    // Relax thresholds so synthetic data produces output
    min_link     = 1
    min_16s_len  = 100
    skip_cp_num  = true
}

// Cap every label to test-machine limits so no process requests more than
// what is actually available on a laptop / CI node.
process {
    withLabel: process_low    { cpus = 1; memory = '1.GB'; time = '30.m' }
    withLabel: process_medium { cpus = 2; memory = '4.GB'; time = '1.h'  }
    withLabel: process_high   { cpus = 2; memory = '4.GB'; time = '1.h'  }
    withLabel: process_matam  { cpus = 2; memory = '4.GB'; time = '1.h'  }
}
